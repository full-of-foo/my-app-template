# Local PostgreSQL started with `docker compose up -d db`
DATABASE_URL=postgres://app:app_local_only@127.0.0.1:54330/app
# Disposable database used by `npm run test:server`
TEST_DATABASE_URL=postgres://app:app_local_only@127.0.0.1:54330/app_test
# Public origin of the web app in production (Render sets RENDER_EXTERNAL_HOSTNAME automatically)
# APP_ORIGIN=https://my-app.example.com
